# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Secrets you make up yourself
ENCRYPTION_KEY=32-or-more-random-characters
META_VERIFY_TOKEN=any-random-string-for-webhook-verification
CRON_SECRET=any-random-string
DASHBOARD_PASSWORD=your-dashboard-password

# Meta app (new apps use "Instagram API setup with Unified login")
META_APP_ID=your-meta-app-id                 # App settings > Basic > App ID
META_APP_SECRET=your-meta-app-secret         # App settings > Basic > App secret
META_CONFIG_ID=your-login-configuration-id   # Facebook Login for Business > Configurations
META_GRAPH_VERSION=v25.0
# Optional: skip auto-detection of the Instagram account
# META_IG_USER_ID=1784...
# Optional: connect from a pasted SYSTEM_USER token instead of the Connect button
# META_INITIAL_ACCESS_TOKEN=

# Shown on /privacy, /terms, /data-deletion and the landing page footer
NEXT_PUBLIC_CONTACT_EMAIL=your-contact-email@example.com
OPERATOR_NAME=Your Name or Organization
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app
